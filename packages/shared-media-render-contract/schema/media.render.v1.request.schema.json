{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"media.render.v1.request",
  "title":"media.render.v1 request",
  "type":"object",
  "additionalProperties":false,
  "required":["contractVersion","messageType","requestId","purpose","language","shots","visualAssets","voice","captions","outputProfile","evidenceRequirements","inputManifestDigest"],
  "properties":{
    "contractVersion":{"const":"media.render.v1"},
    "messageType":{"const":"request"},
    "requestId":{"type":"string","minLength":1},
    "purpose":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
    "title":{"type":"string","minLength":1},
    "language":{"type":"string","minLength":1},
    "shots":{"type":"array","minItems":1,"items":{"type":"object","required":["shotId","order","narration","visualAssetIds"]}},
    "visualAssets":{"type":"array","items":{"type":"object","required":["assetId","kind","locator","sha256"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "voice":{"type":"object"},
    "captions":{"type":"object"},
    "outputProfile":{"type":"object","required":["profileId","width","height","fps","container"]},
    "evidenceRequirements":{"type":"object","required":["requireMediaInspection","requireSha256","requireRenderLog","requireInputManifestDigest"],"properties":{"requireMediaInspection":{"const":true},"requireSha256":{"const":true},"requireRenderLog":{"const":true},"requireInputManifestDigest":{"const":true}}},
    "inputManifestDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
