{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"media.render.v1.evidence",
  "title":"media.render.v1 evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["contractVersion","messageType","requestId","jobId","inputManifestDigest","renderLog","collectedAt"],
  "properties":{
    "contractVersion":{"const":"media.render.v1"},
    "messageType":{"const":"evidence"},
    "requestId":{"type":"string","minLength":1},
    "jobId":{"type":"string","minLength":1},
    "inputManifestDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "artifactSha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "mediaInspection":{"oneOf":[{"type":"null"},{"type":"object","required":["tool","status","inspectedAt","format","streams"],"properties":{"tool":{"const":"ffprobe"},"status":{"const":"passed"},"inspectedAt":{"type":"string","format":"date-time"},"format":{"type":"object","required":["durationSeconds","sizeBytes"]},"streams":{"type":"array","minItems":1}}}]},
    "renderLog":{"type":"object","required":["sha256"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"locator":{"type":"string"},"byteLength":{"type":"integer","minimum":1}}},
    "collectedAt":{"type":"string","format":"date-time"}
  }
}
